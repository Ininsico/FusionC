/* Parser.cup -- CUP grammar for the FusionC tensor-pipeline DSL.
 *
 * Run:  java -cp tools/java-cup.jar java_cup.Main -package io.fusionc.frontend \
 *           -parser parser -symbols sym -destdir src/main/java/io/fusionc/frontend \
 *           src/main/cup/Parser.cup
 *
 * CUP produces sym.java (token constants) and parser.java (LALR tables).
 * The scanner is the JFlex-generated io.fusionc.frontend.Scanner, which implements
 * java_cup.runtime.Scanner and returns java_cup.runtime.Symbol objects.
 *
 * Every production's action builds two things:
 *   1. the AST node the compiler consumes (RESULT), and
 *   2. a derivation node (Deriv) recording the grammar symbol and its children, including
 *      the terminals -- this is the parse tree the Swing viewer draws, top-down.
 *
 * NOTE ON ORDER: CUP's meta-grammar requires the code sections (parser code, scan with)
 * to appear BEFORE the symbol declarations, and "start with" after them. Reordering them
 * makes CUP report "Illegal use of reserved word".
 */
package io.fusionc.frontend;

import io.fusionc.ast.Ast;
import java.util.ArrayList;
import java.util.List;

parser code {:
    /** Any syntax error is fatal: no partial AST is ever handed to the compiler. */
    @Override
    public void syntax_error(java_cup.runtime.Symbol tok) {
        throw new io.fusionc.FrontendException(describe(tok));
    }

    @Override
    public void unrecovered_syntax_error(java_cup.runtime.Symbol tok) {
        throw new io.fusionc.FrontendException(describe(tok));
    }

    private String describe(java_cup.runtime.Symbol tok) {
        if (tok == null || tok.sym == sym.EOF) {
            return "unexpected end of file";
        }
        String text = tok.value != null ? tok.value.toString() : literal(tok.sym);
        return "syntax error at line " + tok.left + ", column " + tok.right
             + ": unexpected '" + text + "'";
    }

    /** Spelling of a valueless token as it appears in the source, for error messages. */
    private String literal(int type) {
        switch (type) {
            case sym.SEMI:     return ";";
            case sym.COMMA:    return ",";
            case sym.COLON:    return ":";
            case sym.EQ:       return "=";
            case sym.ARROW:    return "->";
            case sym.LPAREN:   return "(";
            case sym.RPAREN:   return ")";
            case sym.LBRACKET: return "[";
            case sym.RBRACKET: return "]";
            case sym.CONST:    return "const";
            case sym.DTYPE:    return "dtype";
            case sym.STORE:    return "store";
            case sym.ACCUM:    return "accum";
            case sym.INPUT:    return "input";
            case sym.PARAM:    return "param";
            case sym.FP16:     return "fp16";
            case sym.FP32:     return "fp32";
            default:           return sym.terminalNames[type];
        }
    }
:};

scan with {: return ((java_cup.runtime.Scanner) getScanner()).next_token(); :};

/* ------------------------------ terminals ------------------------------ */
terminal Long    INT;
terminal Double  FLOAT;
terminal String  IDENT;
terminal CONST, DTYPE, STORE, ACCUM, INPUT, PARAM, FP16, FP32;
terminal SEMI, COMMA, COLON, EQ, ARROW, LPAREN, RPAREN, LBRACKET, RBRACKET;

/* ---------------------------- non terminals ---------------------------- */
non terminal Ast.Program            program;
non terminal List<Ast.Decl>         decl_list;
non terminal Ast.Decl               decl;
non terminal String                 datatype;
non terminal List<Ast.Expr>         dims, expr_list;
non terminal Ast.Expr               expr;
non terminal List<Ast.Pipeline>     stmt_list;
non terminal Ast.Pipeline           stmt;
non terminal List<Ast.Stage>        stage_list;
non terminal Ast.Stage              stage;
non terminal List<Ast.Expr>         arglist;

start with program;

/* ------------------------------- grammar ------------------------------- */
program ::= decl_list:dl stmt_list:sl
        {: Ast.Program p = new Ast.Program(dl, sl);
           RESULT = p;
           Derivs.put(p, Deriv.rule("program", Derivs.of(dl), Derivs.of(sl)));
           ParseTrace.say("syntax valid: program parsed"); :}
        ;

decl_list ::= decl_list:l decl:d
        {: l.add(d);
           RESULT = l;
           Derivs.put(l, Deriv.rule("decl_list", Derivs.of(l), Derivs.of(d))); :}
        | /* empty */
        {: RESULT = new ArrayList<Ast.Decl>();
           Derivs.put(RESULT, Deriv.rule("decl_list")); :}
        ;

decl ::= CONST IDENT:name EQ INT:value SEMI
        {: RESULT = new Ast.ConstDecl(name, ((Long) value).longValue(), 0);
           Derivs.put(RESULT, Deriv.rule("decl",
               Deriv.terminal("CONST", "const"),
               Deriv.terminal("IDENT", String.valueOf(name)),
               Deriv.terminal("EQ", "="),
               Deriv.terminal("INT", String.valueOf(value)),
               Deriv.terminal("SEMI", ";")));
           ParseTrace.say("const declaration: " + name + " = " + value); :}
       | DTYPE datatype:store STORE datatype:accum ACCUM SEMI
        {: RESULT = new Ast.DtypeDecl(store, accum);
           Derivs.put(RESULT, Deriv.rule("decl",
               Deriv.terminal("DTYPE", "dtype"),
               Derivs.of(store),
               Deriv.terminal("STORE", "store"),
               Derivs.of(accum),
               Deriv.terminal("ACCUM", "accum"),
               Deriv.terminal("SEMI", ";")));
           ParseTrace.say("dtype policy: store " + store + ", accumulate " + accum); :}
       | INPUT IDENT:name COLON datatype:dt dims:d SEMI
        {: RESULT = Ast.TensorDecl.host(name, dt, d, true);
           Derivs.put(RESULT, Deriv.rule("decl",
               Deriv.terminal("INPUT", "input"),
               Deriv.terminal("IDENT", String.valueOf(name)),
               Deriv.terminal("COLON", ":"),
               Derivs.of(dt),
               Derivs.of(d),
               Deriv.terminal("SEMI", ";")));
           ParseTrace.say("input declaration: " + name); :}
       | PARAM IDENT:name COLON datatype:dt dims:d SEMI
        {: RESULT = Ast.TensorDecl.host(name, dt, d, false);
           Derivs.put(RESULT, Deriv.rule("decl",
               Deriv.terminal("PARAM", "param"),
               Deriv.terminal("IDENT", String.valueOf(name)),
               Deriv.terminal("COLON", ":"),
               Derivs.of(dt),
               Derivs.of(d),
               Deriv.terminal("SEMI", ";")));
           ParseTrace.say("param declaration: " + name); :}
       ;

datatype ::= FP16
        {: RESULT = new String("fp16");
           Derivs.put(RESULT, Deriv.rule("datatype", Deriv.terminal("FP16", "fp16"))); :}
           | FP32
        {: RESULT = new String("fp32");
           Derivs.put(RESULT, Deriv.rule("datatype", Deriv.terminal("FP32", "fp32"))); :}
           ;

dims ::= LBRACKET expr_list:l RBRACKET
        {: RESULT = l;
           Derivs.put(l, Deriv.rule("dims",
               Deriv.terminal("LBRACKET", "["), Derivs.of(l),
               Deriv.terminal("RBRACKET", "]"))); :}
       ;

expr_list ::= expr_list:l COMMA expr:e
        {: l.add(e);
           RESULT = l;
           Derivs.put(l, Deriv.rule("expr_list", Derivs.of(l),
               Deriv.terminal("COMMA", ","), Derivs.of(e))); :}
            | expr:e
        {: RESULT = new ArrayList<Ast.Expr>(); RESULT.add(e);
           Derivs.put(RESULT, Deriv.rule("expr_list", Derivs.of(e))); :}
            ;

expr ::= INT:i
        {: RESULT = new Ast.IntLit(((Long) i).longValue());
           Derivs.put(RESULT, Deriv.rule("expr", Deriv.terminal("INT", String.valueOf(i)))); :}
       | FLOAT:f
        {: RESULT = new Ast.FloatLit((Double) f);
           Derivs.put(RESULT, Deriv.rule("expr", Deriv.terminal("FLOAT", String.valueOf(f)))); :}
       | IDENT:n
        {: RESULT = new Ast.Ref(n);
           Derivs.put(RESULT, Deriv.rule("expr", Deriv.terminal("IDENT", String.valueOf(n)))); :}
       | LPAREN expr:e RPAREN
        {: RESULT = e;
           Derivs.put(e, Deriv.rule("expr",
               Deriv.terminal("LPAREN", "("), Derivs.of(e),
               Deriv.terminal("RPAREN", ")"))); :}
       ;

stmt_list ::= stmt_list:l stmt:s
        {: l.add(s);
           RESULT = l;
           Derivs.put(l, Deriv.rule("stmt_list", Derivs.of(l), Derivs.of(s))); :}
        | /* empty */
        {: RESULT = new ArrayList<Ast.Pipeline>();
           Derivs.put(RESULT, Deriv.rule("stmt_list")); :}
        ;

stmt ::= IDENT:out EQ stage_list:sl SEMI
        {: RESULT = new Ast.Pipeline(out, sl, 0);
           Derivs.put(RESULT, Deriv.rule("stmt",
               Deriv.terminal("IDENT", String.valueOf(out)),
               Deriv.terminal("EQ", "="),
               Derivs.of(sl),
               Deriv.terminal("SEMI", ";")));
           ParseTrace.say("statement parsed: pipeline -> " + out); :}
        ;

stage_list ::= stage_list:l ARROW stage:s
        {: l.add(s);
           RESULT = l;
           Derivs.put(l, Deriv.rule("stage_list", Derivs.of(l),
               Deriv.terminal("ARROW", "->"), Derivs.of(s))); :}
        | stage:s
        {: RESULT = new ArrayList<Ast.Stage>(); RESULT.add(s);
           Derivs.put(RESULT, Deriv.rule("stage_list", Derivs.of(s))); :}
        ;

stage ::= IDENT:name LPAREN arglist:a RPAREN
        {: RESULT = new Ast.Call(name, a, 0, 0);
           Derivs.put(RESULT, Deriv.rule("stage",
               Deriv.terminal("IDENT", String.valueOf(name)),
               Deriv.terminal("LPAREN", "("),
               Derivs.of(a),
               Deriv.terminal("RPAREN", ")")));
           ParseTrace.say("stage parsed: call " + name); :}
        | IDENT:name
        {: RESULT = new Ast.Name(name);
           Derivs.put(RESULT, Deriv.rule("stage",
               Deriv.terminal("IDENT", String.valueOf(name))));
           ParseTrace.say("stage parsed: name " + name); :}
        ;

arglist ::= expr_list:l
        {: RESULT = l;
           Derivs.put(l, Deriv.rule("arglist", Derivs.of(l))); :}
          | /* empty */
        {: RESULT = new ArrayList<Ast.Expr>();
           Derivs.put(RESULT, Deriv.rule("arglist")); :}
          ;
